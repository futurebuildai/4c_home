# Copy to .env (git-ignored). EXPO_PUBLIC_* values are bundled into the app.

# Self-hosted Appwrite API endpoint and the "4C" project's ID
# (Appwrite console → 4C → Settings → Project ID).
EXPO_PUBLIC_APPWRITE_ENDPOINT=https://console.futurebuild.ai/v1
EXPO_PUBLIC_APPWRITE_PROJECT_ID=

# Household = Appwrite team id; created by `npm run appwrite:setup`.
EXPO_PUBLIC_HOUSEHOLD_ID=household-4c

# --- Admin scripts only (never prefix with EXPO_PUBLIC_) ---
# API key with scopes: tables.*, rows.*, buckets.*, files.*, teams.*,
# users.*, functions.*, execution.*  (Appwrite console → 4C → Overview → API keys)
APPWRITE_API_KEY=
HOUSEHOLD_NAME=4C
HOUSEHOLD_TIMEZONE=America/Chicago
